/* ---------------------------- *\
    
    $Typography

\* ---------------------------- */

// The size of each tag comes from theme.json, so the editor and the front
// never drift apart. These classes apply the same scale to any other element.

h1, h2, h3, h4, h5, h6
    text-wrap balance
h1, h2, h3, h4, h5, h6, p
    margin-top 0

.alpha
    font-size fontsize('alpha')
    line-height lineheight('alpha')
.beta
    font-size fontsize('beta')
    line-height lineheight('beta')
.gamma
    font-size fontsize('gamma')
    line-height lineheight('gamma')
.delta
    font-size fontsize('delta')
    line-height lineheight('delta')
.epsilon
    font-size fontsize('epsilon')
    line-height lineheight('epsilon')
.zeta
    font-size fontsize('zeta')
    line-height lineheight('zeta')
