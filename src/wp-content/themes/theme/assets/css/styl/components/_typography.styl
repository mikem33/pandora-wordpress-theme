/* ---------------------------- *\
    
    $Typography

\* ---------------------------- */

h1, h2, h3, h4, h5, h6
    text-wrap balance
h1, h2, h3, h4, h5, h6, p
    margin-top 0

// Each size in tokens.json styles its tag and a class of the same name
for $slug, $size in $sizes
    $selector = $size['tag'] + ', .' + $slug
    {$selector}
        if $size['min'] == $size['max']
            font-size $size['min']
        else
            font-size "clamp(%s, %s, %s)" % ($size['min'] $size['fluid'] $size['max'])
        if $size['lineHeightMin'] == $size['lineHeightMax']
            line-height $size['lineHeightMin']
        else
            line-height "clamp(%s, %s, %s)" % ($size['lineHeightMin'] $size['fluid'] $size['lineHeightMax'])
