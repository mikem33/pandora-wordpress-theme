{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "75rem",
            "wideSize": "90rem"
        },
        "color": {
            "custom": true,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                {
                    "slug": "dark-grey",
                    "name": "Dark grey",
                    "color": "#333333"
                },
                {
                    "slug": "light-grey",
                    "name": "Light grey",
                    "color": "#666666"
                },
                {
                    "slug": "white",
                    "name": "White",
                    "color": "#ffffff"
                },
                {
                    "slug": "black",
                    "name": "Black",
                    "color": "#000000"
                }
            ]
        },
        "typography": {
            "fluid": false,
            "defaultFontSizes": false,
            "fontFamilies": [
                {
                    "slug": "system",
                    "name": "System",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
                }
            ],
            "fontSizes": [
                {
                    "slug": "text",
                    "name": "Texto",
                    "size": "clamp(1rem, 1vw, 1.125rem)"
                },
                {
                    "slug": "zeta",
                    "name": "Zeta",
                    "size": "clamp(1.125rem, 2vw, 1.375rem)"
                },
                {
                    "slug": "epsilon",
                    "name": "Epsilon",
                    "size": "clamp(1.25rem, 2vw, 1.5rem)"
                },
                {
                    "slug": "delta",
                    "name": "Delta",
                    "size": "clamp(1.5rem, 2vw, 2rem)"
                },
                {
                    "slug": "gamma",
                    "name": "Gamma",
                    "size": "clamp(1.75rem, 3vw, 2.625rem)"
                },
                {
                    "slug": "beta",
                    "name": "Beta",
                    "size": "clamp(1.875rem, 4vw, 3.5rem)"
                },
                {
                    "slug": "alpha",
                    "name": "Alpha",
                    "size": "clamp(2.1875rem, 5vw, 4.125rem)"
                }
            ]
        },
        "spacing": {
            "units": [
                "px",
                "rem",
                "em",
                "%",
                "vw",
                "vh"
            ],
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "slug": "20",
                    "name": "1",
                    "size": "1rem"
                },
                {
                    "slug": "40",
                    "name": "2",
                    "size": "1.875rem"
                },
                {
                    "slug": "60",
                    "name": "3",
                    "size": "2.8125rem"
                },
                {
                    "slug": "80",
                    "name": "4",
                    "size": "4rem"
                }
            ]
        },
        "custom": {
            "lineHeight": {
                "text": "1.4",
                "zeta": "clamp(1.25rem, 2vw, 1.625rem)",
                "epsilon": "clamp(1.5rem, 2vw, 1.75rem)",
                "delta": "clamp(1.625rem, 2vw, 2rem)",
                "gamma": "clamp(1.875rem, 3vw, 2.625rem)",
                "beta": "clamp(2rem, 4vw, 3.5rem)",
                "alpha": "clamp(2.375rem, 5vw, 4.125rem)"
            }
        }
    },
    "styles": {
        "color": {
            "text": "var(--wp--preset--color--dark-grey)",
            "background": "var(--wp--preset--color--white)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system)",
            "fontSize": "var(--wp--preset--font-size--text)",
            "lineHeight": "var(--wp--custom--line-height--text)"
        },
        "elements": {
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--alpha)",
                    "lineHeight": "var(--wp--custom--line-height--alpha)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--beta)",
                    "lineHeight": "var(--wp--custom--line-height--beta)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--gamma)",
                    "lineHeight": "var(--wp--custom--line-height--gamma)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--delta)",
                    "lineHeight": "var(--wp--custom--line-height--delta)"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--epsilon)",
                    "lineHeight": "var(--wp--custom--line-height--epsilon)"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--zeta)",
                    "lineHeight": "var(--wp--custom--line-height--zeta)"
                }
            },
            "p": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--text)",
                    "lineHeight": "var(--wp--custom--line-height--text)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--dark-grey)"
                }
            }
        }
    }
}
