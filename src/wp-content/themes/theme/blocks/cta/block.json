{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "{{theme_slug}}/cta",
    "title": "CTA",
    "category": "{{theme_slug}}",
    "icon": "megaphone",
    "description": "A heading, a line of text and a link. The reference block: copy the folder to start a new one.",
    "textdomain": "{{theme_slug}}",
    "attributes": {
        "heading": {
            "type": "string",
            "default": ""
        },
        "text": {
            "type": "string",
            "default": ""
        },
        "buttonText": {
            "type": "string",
            "default": ""
        },
        "buttonUrl": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "style": "file:./style.css",
    "render": "file:./render.php"
}
