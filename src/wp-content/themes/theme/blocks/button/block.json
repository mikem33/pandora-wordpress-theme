{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "{{theme_slug}}/button",
    "title": "Button",
    "category": "{{theme_slug}}",
    "icon": "button",
    "description": "A link styled as a button. The reference block: copy the folder to start a new one.",
    "textdomain": "{{theme_slug}}",
    "attributes": {
        "text": {
            "type": "string",
            "default": ""
        },
        "url": {
            "type": "string",
            "default": ""
        },
        "opensInNewTab": {
            "type": "boolean",
            "default": false
        }
    },
    "supports": {
        "html": false,
        "align": [
            "left",
            "center",
            "right"
        ]
    },
    "style": "{{theme_slug}}-block-button",
    "editorStyle": "{{theme_slug}}-block-button-editor",
    "editorScript": "{{theme_slug}}-block-button-editor",
    "render": "file:./render.php"
}
